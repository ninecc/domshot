{
  "manifest_version": 3,
  "name": "DOMShot",
  "description": "选择网页元素并高保真导出图片。Powered by SnapDOM。",
  "version": "0.1.0",
  "action": {
    "default_title": "DOMShot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [{
    "resources": ["permission.html"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
