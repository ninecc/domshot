{
  "name": "domshot",
  "version": "0.1.0",
  "description": "DOMShot browser extension — capture DOM elements as images, powered by SnapDOM.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build.mjs --watch"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.24.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "esbuild": "^0.25.9",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.9.2"
  }
}
